step "run-a-script" {
    name = "Run a Script"
    properties = {
        Octopus.Action.TargetRoles = "single"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.GitRepository.Source = "Project"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptFileName = "scripts/script.ps"
            Octopus.Action.Script.ScriptSource = "GitRepository"
        }
        worker_pool_variable = ""
    }
}

step "iis" {
    name = "IIS"
    properties = {
        Octopus.Action.TargetRoles = "cli"
    }

    action {
        properties = {
            Octopus.Action.Package.FeedId = "octopus-server-built-in"
            Octopus.Action.Package.PackageId = "buildinfo"
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Template.Id = "ActionTemplates-5903"
            Octopus.Action.Template.Version = "1"
            package = "{\"PackageId\":\"buildinfo\",\"FeedId\":\"octopus-server-built-in\"}"
        }
        worker_pool_variable = ""

        packages {
            acquisition_location = "Server"
            feed = "octopus-server-built-in"
            package_id = "buildinfo"
            properties = {
                PackageParameterName = "package"
                SelectionMode = "deferred"
            }
        }
    }
}